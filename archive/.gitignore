# .gitignore - Files to exclude from version control

# Environment variables
.env
.env.local
.env.*.local

# IDE & Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
*.swp
*.swo
*~

# Build & Dependencies
node_modules/
dist/
build/
.npm

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# OS
Thumbs.db
.DS_Store

# Temporary files
*.bak
*.tmp
*.temp

# Cache
.cache/
.eslintcache

# Production
.vercel
.netlify

# Local testing files
test/
*.test.js
